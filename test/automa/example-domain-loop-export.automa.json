{
  "extVersion": "1.30.02",
  "name": "Example Domain - Loop Links and Export",
  "icon": "riLoopLeftLine",
  "table": [
    {
      "id": "link_text",
      "name": "link_text",
      "type": "string"
    }
  ],
  "version": "1.30.02",
  "drawflow": {
    "nodes": [
      {
        "type": "BlockBasic",
        "id": "trigger-1",
        "label": "trigger",
        "position": { "x": 80, "y": 240 },
        "data": { "type": "manual" }
      },
      {
        "type": "BlockBasic",
        "id": "open-example-1",
        "label": "new-tab",
        "position": { "x": 350, "y": 240 },
        "data": {
          "url": "https://example.com/",
          "active": true,
          "waitTabLoaded": true
        }
      },
      {
        "type": "BlockBasic",
        "id": "loop-links-1",
        "label": "loop-elements",
        "position": { "x": 620, "y": 240 },
        "data": {
          "loopId": "links",
          "selector": "a",
          "maxLoop": "0",
          "reverseLoop": false,
          "findBy": "cssSelector",
          "actionElSelector": "",
          "actionElMaxWaitTime": 5,
          "actionPageMaxWaitTime": 10,
          "loadMoreAction": "none",
          "scrollToBottom": true,
          "waitForSelector": true,
          "waitSelectorTimeout": 5000
        }
      },
      {
        "type": "BlockBasic",
        "id": "read-link-1",
        "label": "get-text",
        "position": { "x": 890, "y": 240 },
        "data": {
          "findBy": "cssSelector",
          "selector": "{{loopData.links}}",
          "waitForSelector": true,
          "waitSelectorTimeout": 5000,
          "multiple": false,
          "saveData": true,
          "dataColumn": "link_text",
          "useTextContent": true
        }
      },
      {
        "type": "BlockLoopBreakpoint",
        "id": "loop-breakpoint-1",
        "label": "loop-breakpoint",
        "position": { "x": 1160, "y": 240 },
        "data": {
          "loopId": "links",
          "clearLoop": false
        }
      },
      {
        "type": "BlockBasic",
        "id": "export-links-1",
        "label": "export-data",
        "position": { "x": 1430, "y": 240 },
        "data": {
          "name": "example-domain-links",
          "type": "json",
          "description": "Export collected link text.",
          "variableName": "",
          "addBOMHeader": false,
          "onConflict": "uniquify",
          "dataToExport": "data-columns"
        }
      },
      {
        "type": "BlockBasic",
        "id": "notification-1",
        "label": "notification",
        "position": { "x": 1700, "y": 240 },
        "data": {
          "message": "Link text was collected and exported as JSON.",
          "title": "Automa loop test"
        }
      }
    ],
    "edges": [
      {
        "id": "edge-trigger-open",
        "source": "trigger-1",
        "target": "open-example-1",
        "sourceHandle": "trigger-1-output-1",
        "targetHandle": "open-example-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-open-loop",
        "source": "open-example-1",
        "target": "loop-links-1",
        "sourceHandle": "open-example-1-output-1",
        "targetHandle": "loop-links-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-loop-read",
        "source": "loop-links-1",
        "target": "read-link-1",
        "sourceHandle": "loop-links-1-output-1",
        "targetHandle": "read-link-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-read-breakpoint",
        "source": "read-link-1",
        "target": "loop-breakpoint-1",
        "sourceHandle": "read-link-1-output-1",
        "targetHandle": "loop-breakpoint-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-breakpoint-export",
        "source": "loop-breakpoint-1",
        "target": "export-links-1",
        "sourceHandle": "loop-breakpoint-1-output-1",
        "targetHandle": "export-links-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-export-notification",
        "source": "export-links-1",
        "target": "notification-1",
        "sourceHandle": "export-links-1-output-1",
        "targetHandle": "notification-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      }
    ],
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "settings": {
    "execContext": "popup",
    "notification": true,
    "onError": "stop-workflow"
  },
  "globalData": "{}",
  "description": "Open Example Domain, loop through links, collect their text, and export the table as JSON.",
  "includedWorkflows": {}
}
