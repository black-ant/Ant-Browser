{
  "extVersion": "1.30.02",
  "name": "Example Domain - Click Link",
  "icon": "riCursorLine",
  "table": [],
  "version": "1.30.02",
  "drawflow": {
    "nodes": [
      {
        "type": "BlockBasic",
        "id": "trigger-1",
        "label": "trigger",
        "position": { "x": 100, "y": 220 },
        "data": { "type": "manual" }
      },
      {
        "type": "BlockBasic",
        "id": "open-example-1",
        "label": "new-tab",
        "position": { "x": 390, "y": 220 },
        "data": {
          "url": "https://example.com/",
          "active": true,
          "waitTabLoaded": true
        }
      },
      {
        "type": "BlockBasic",
        "id": "click-link-1",
        "label": "event-click",
        "position": { "x": 680, "y": 220 },
        "data": {
          "findBy": "cssSelector",
          "selector": "a",
          "waitForSelector": true,
          "waitSelectorTimeout": 5000,
          "multiple": false
        }
      },
      {
        "type": "BlockBasic",
        "id": "notification-1",
        "label": "notification",
        "position": { "x": 970, "y": 220 },
        "data": {
          "message": "The Example Domain link was clicked.",
          "title": "Automa click test"
        }
      }
    ],
    "edges": [
      {
        "id": "edge-trigger-open",
        "source": "trigger-1",
        "target": "open-example-1",
        "sourceHandle": "trigger-1-output-1",
        "targetHandle": "open-example-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-open-click",
        "source": "open-example-1",
        "target": "click-link-1",
        "sourceHandle": "open-example-1-output-1",
        "targetHandle": "click-link-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-click-notification",
        "source": "click-link-1",
        "target": "notification-1",
        "sourceHandle": "click-link-1-output-1",
        "targetHandle": "notification-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      }
    ],
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "settings": {
    "execContext": "popup",
    "notification": true,
    "onError": "stop-workflow"
  },
  "globalData": "{}",
  "description": "Open Example Domain, click its link, and show a success notification.",
  "includedWorkflows": {}
}
