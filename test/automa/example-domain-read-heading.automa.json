{
  "extVersion": "1.30.02",
  "name": "Example Domain - Read Heading",
  "icon": "riFileTextLine",
  "table": [],
  "version": "1.30.02",
  "drawflow": {
    "nodes": [
      {
        "type": "BlockBasic",
        "id": "trigger-1",
        "label": "trigger",
        "position": { "x": 100, "y": 220 },
        "data": { "type": "manual" }
      },
      {
        "type": "BlockBasic",
        "id": "open-example-1",
        "label": "new-tab",
        "position": { "x": 390, "y": 220 },
        "data": {
          "url": "https://example.com/",
          "active": true,
          "waitTabLoaded": true
        }
      },
      {
        "type": "BlockBasic",
        "id": "read-heading-1",
        "label": "get-text",
        "position": { "x": 680, "y": 220 },
        "data": {
          "findBy": "cssSelector",
          "selector": "h1",
          "waitForSelector": true,
          "waitSelectorTimeout": 5000,
          "multiple": false,
          "saveData": false,
          "assignVariable": true,
          "variableName": "pageTitle",
          "useTextContent": true
        }
      },
      {
        "type": "BlockBasic",
        "id": "notification-1",
        "label": "notification",
        "position": { "x": 970, "y": 220 },
        "data": {
          "message": "The h1 heading was stored in pageTitle.",
          "title": "Automa read test"
        }
      }
    ],
    "edges": [
      {
        "id": "edge-trigger-open",
        "source": "trigger-1",
        "target": "open-example-1",
        "sourceHandle": "trigger-1-output-1",
        "targetHandle": "open-example-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-open-read",
        "source": "open-example-1",
        "target": "read-heading-1",
        "sourceHandle": "open-example-1-output-1",
        "targetHandle": "read-heading-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      },
      {
        "id": "edge-read-notification",
        "source": "read-heading-1",
        "target": "notification-1",
        "sourceHandle": "read-heading-1-output-1",
        "targetHandle": "notification-1-input-1",
        "type": "custom",
        "markerEnd": "arrowclosed"
      }
    ],
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "settings": {
    "execContext": "popup",
    "notification": true,
    "onError": "stop-workflow"
  },
  "globalData": "{}",
  "description": "Open Example Domain, read its h1 heading into pageTitle, and show a success notification.",
  "includedWorkflows": {}
}
